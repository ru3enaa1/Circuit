{
  "name": "circuit",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test:coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:dump-schema": "vitest run schema-dump-db --project database --update=all",
    "db:users": "node database/users.ts",
    "db:keys": "node database/keys.ts",
    "crm:start": "node --env-file-if-exists=.env apps/crm/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
