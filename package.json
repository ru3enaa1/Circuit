{
  "name": "circuit",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test:coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:dump-schema": "vitest run schema-dump-db --project database --update=all",
    "db:users": "node database/users.ts",
    "db:keys": "node database/keys.ts",
    "db:backup": "node database/backup.ts",
    "db:restore": "node database/restore.ts",
    "db:seed": "node database/seed.ts",
    "crm:start": "node --env-file-if-exists=.env apps/crm/src/main.ts",
    "golden:update": "node apps/circuit/test/golden/update.ts",
    "circuit:start": "node --env-file-if-exists=.env apps/circuit/src/main.ts",
    "board:build": "npm run build -w @circuit/board",
    "board:favicon": "vitest run favicon --project @circuit/board --update=all",
    "board:shots": "npm run board:build && node apps/circuit/test/shots/board-shots.ts",
    "board:gif": "npm run board:build && node apps/circuit/test/shots/board-gif.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "gifenc": "1.0.3",
    "pg": "8.23.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
