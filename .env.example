# Copy to .env (git-ignored) and fill in. Compose, drizzle-kit and the tests read it.
# Save it as UTF-8 without BOM: a BOM glues itself to the first variable's name.

# Local PostgreSQL admin. It runs migrations and creates the disposable test databases;
# each service gets its own least-privilege user in F1 (ADR-0003, M4).
POSTGRES_USER=circuit_admin
# No default on purpose: every clone sets its own.
POSTGRES_PASSWORD=
POSTGRES_DB=circuit

# Published on 127.0.0.1 only. Change it if another PostgreSQL already uses 5432.
DB_PORT=5432

# The CRM's own database user, crm_app (ADR-0006). `npm run db:users` creates it with this
# password, and the CRM logs in with it, never as the admin. 16 to 128 letters, digits, - _ . ~
# No default on purpose. One way to make one:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
CRM_DB_PASSWORD=

# The CRM's HTTP port, on 127.0.0.1 only.
CRM_PORT=4010

# The scenario `npm run db:seed` loads: the folder scenarios/<id>/ (ADR-0009 D7).
CIRCUIT_SCENARIO=escuela
# Where the seed leaves the agent's CRM key, relative to the repository root (ADR-0009 D20, D21).
# .gitignore keeps .secrets/ out of git; the key never goes in this file or in the terminal.
CRM_AGENT_KEY_FILE=.secrets/crm-agent-key
