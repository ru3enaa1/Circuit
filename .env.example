# Copy to .env (git-ignored) and fill in. Compose, drizzle-kit and the tests read it.
# Save it as UTF-8 without BOM: a BOM glues itself to the first variable's name.

# Local PostgreSQL admin. It runs migrations and creates the disposable test databases;
# each service gets its own least-privilege user in F1 (ADR-0003, M4).
POSTGRES_USER=circuit_admin
# No default on purpose: every clone sets its own.
POSTGRES_PASSWORD=
POSTGRES_DB=circuit

# Published on 127.0.0.1 only. Change it if another PostgreSQL already uses 5432.
DB_PORT=5432

# The CRM's own database user, crm_app (ADR-0006). `npm run db:users` creates it with this
# password, and the CRM logs in with it, never as the admin. 16 to 128 letters, digits, - _ . ~
# No default on purpose. One way to make one:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
CRM_DB_PASSWORD=

# Circuit's own database user, circuit_app (ADR-0010 D11): a member of circuit_service only,
# which reads and adds events and never changes one. `npm run db:users` creates it with this
# password, the same way and with the same rule as CRM_DB_PASSWORD. No default on purpose.
CIRCUIT_DB_PASSWORD=

# The CRM's HTTP port, on 127.0.0.1 only.
CRM_PORT=4010

# Circuit's HTTP port, on 127.0.0.1 only: the board and its read API (ADR-0011 B6). Unset, 4020.
# No variable changes the address: circuit never listens outside this machine.
CIRCUIT_PORT=4020

# The scenario `npm run db:seed` loads: the folder scenarios/<id>/ (ADR-0009 D7).
CIRCUIT_SCENARIO=escuela
# Where the seed leaves the agent's CRM key, relative to the repository root (ADR-0009 D20, D21).
# .gitignore keeps .secrets/ out of git; the key never goes in this file or in the terminal.
CRM_AGENT_KEY_FILE=.secrets/crm-agent-key

# Who signs every decision of station 6 in the CRM's audit trail (ADR-0012 A7): 1 to 40 lowercase
# letters, digits or "-", never key-<n>. Unset, "mentor". There is no login: the demonstration is
# local and for one person (ADR-0012, question 5).
CIRCUIT_MENTOR=mentor
# The model of stations 3 to 5 (ADR-0015): unset or "simulator", the default. "anthropic" calls
# Anthropic's API with ANTHROPIC_API_KEY and spends tokens; the demonstration never turns it on
# (ADR-0015 A1). The key goes only in .env, which git ignores, never here.
CIRCUIT_MODEL=simulator
# ANTHROPIC_API_KEY=
# Where circuit reaches the CRM, with the key of CRM_AGENT_KEY_FILE (ADR-0012 A9). Only
# http://127.0.0.1:<port> or http://localhost:<port>. Unset, http://127.0.0.1:4010.
CRM_URL=http://127.0.0.1:4010
