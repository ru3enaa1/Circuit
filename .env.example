# Copy to .env (git-ignored) and fill in. Compose, drizzle-kit and the tests read it.
# Save it as UTF-8 without BOM: a BOM glues itself to the first variable's name.

# Local PostgreSQL admin. It runs migrations and creates the disposable test databases;
# each service gets its own least-privilege user in F1 (ADR-0003, M4).
POSTGRES_USER=circuit_admin
# No default on purpose: every clone sets its own.
POSTGRES_PASSWORD=
POSTGRES_DB=circuit

# Published on 127.0.0.1 only. Change it if another PostgreSQL already uses 5432.
DB_PORT=5432
